NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-5.6-luna
# AI Advice月間呼び出し上限の目安（概算表示用）。未設定時は200。0以下で上限表示を無効化。
AI_ADVICE_MONTHLY_CALL_LIMIT=200
# Google OAuth Web client credentials. Server-side Calendar token refresh only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Base64-encoded 32-byte key used only for AES-256-GCM refresh-token encryption.
CALENDAR_TOKEN_ENCRYPTION_KEY=
# At least 32 characters; signs the short-lived HttpOnly Calendar OAuth cookie.
CALENDAR_OAUTH_STATE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
